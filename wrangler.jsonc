{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "erstwaehlerforum-homepage",
  "compatibility_date": "2026-05-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "alias": {
    "#tanstack-router-entry": "./src/router.tsx",
    "#tanstack-start-entry": "./src/server.ts",
    "#tanstack-start-plugin-adapters": "./src/server.ts",
    "tanstack-start-manifest:v": "./src/router.tsx",
    "tanstack-start-injected-head-scripts:v": "./src/router.tsx",
  },
}
